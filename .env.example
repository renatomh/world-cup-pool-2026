# Application
APP_NAME="World Cup Pool 2026"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://pool:pool@localhost:5432/world_cup_pool

# Redis
REDIS_URL=redis://localhost:6379/0

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt_BR
DEFAULT_TIMEZONE=UTC

# Betting
BET_LOCK_MINUTES_BEFORE_KICKOFF=15

# JWT auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
JWT_COOKIE_NAME=wc_pool_access_token
JWT_REFRESH_COOKIE_NAME=wc_pool_refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTPONLY=true

# Dev seed (make seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=demo12345
